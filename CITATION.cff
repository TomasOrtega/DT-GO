    given-names: Tomas
  - family-names: Jafarkhani
    given-names: Hamid
repository-code: "https://github.com/TomasOrtega/DT-GO"
license: Apache-2.0
keywords:
  - decentralized optimization
  - distributed optimization
  - gossip algorithms
  - network delays
